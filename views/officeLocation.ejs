<div class="office-card">
  <div class="office-card-top">
    <div class="office-type-badge"><%= location.office %></div>
    <h3 class="office-city">
      <span class="office-city-dot"></span><%= location.city %>
    </h3>
  </div>
  <div class="office-body">

    <div class="office-info-row">
      <div class="office-icon">
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
          <path d="M8 1.5a4.5 4.5 0 0 0-4.5 4.5C3.5 9.5 8 14.5 8 14.5S12.5 9.5 12.5 6A4.5 4.5 0 0 0 8 1.5z" stroke="#1b7f67" stroke-width="1.3"/>
          <circle cx="8" cy="6" r="1.5" fill="#1b7f67"/>
        </svg>
      </div>
      <div>
        <p class="office-info-label">Address</p>
        <p class="office-info-value"><%= location.location %></p>
      </div>
    </div>

    <div class="office-sep"></div>

    <div class="office-info-row">
      <div class="office-icon">
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
          <path d="M3.5 2h2l1 3-1.5 1a7 7 0 0 0 4 4l1-1.5 3 1v2C13.5 13 12 14 10.5 14 6 14 2 10 2 5.5 2 4 3 2.5 3.5 2z" stroke="#1b7f67" stroke-width="1.3" stroke-linejoin="round"/>
        </svg>
      </div>
      <div>
        <p class="office-info-label">Phone</p>
        <p class="office-info-value"><%= location.phone %></p>
      </div>
    </div>

    <div class="office-sep"></div>

    <div class="office-info-row">
      <div class="office-icon">
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
          <rect x="1.5" y="3.5" width="13" height="9" rx="1.5" stroke="#1b7f67" stroke-width="1.3"/>
          <path d="M1.5 5l6.5 4.5L14.5 5" stroke="#1b7f67" stroke-width="1.3" stroke-linecap="round"/>
        </svg>
      </div>
      <div>
        <p class="office-info-label">Email</p>
        <p class="office-info-value"><%= location.email %></p>
      </div>
    </div>

    <a class="office-map-btn" href="<%= location.mapUrl %>" target="_blank" rel="noopener">
      <svg width="14" height="14" viewBox="0 0 16 16" fill="none">
        <path d="M8 1.5a4.5 4.5 0 0 0-4.5 4.5C3.5 9.5 8 14.5 8 14.5S12.5 9.5 12.5 6A4.5 4.5 0 0 0 8 1.5z" stroke="#1b7f67" stroke-width="1.4"/>
        <circle cx="8" cy="6" r="1.5" fill="#1b7f67"/>
      </svg>
      View on Map
    </a>

  </div>
</div>