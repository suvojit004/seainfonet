<!-- ══ PRODUCTS ══ -->
<section id="products">
  <div class="container">
    <div class="products-header reveal">
      <div class="section-eyebrow">Our Portfolio</div>
      <h2 class="section-title">Enterprise-Grade Security Solutions</h2>
      <p class="section-sub">We distribute the world's best cybersecurity brands — from endpoint protection to DLP,
        backup, email security, and network visibility.</p>
    </div>
    <div class="products-grid">
      <%data.forEach(element=> {%>
        <div class="product-card reveal">
          <div class="product-icon">
            <img src="<%= element.imageLink %>">
          </div>
          <div>
            <h3><%= element.title %></h3>
            <p><%= element.description %></p>
          </div>
          <div class="product-tags">
            <%element.tags.forEach(element => {%>
              <span class="tag"><%= element %></span>
            <%});%>
          </div>
          <a href="<%= element.button.link %>" class="product-link"><%= element.button.text %></a>
        </div>
        <%});%>
    </div>
  </div>
</section>