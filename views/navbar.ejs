<%# ══ NAVBAR ══ %>
  <nav id="sea-nav">
    <div class="sea-container">
      <div class="sea-nav-inner">
        <a href="/" class="sea-nav-logo">
          <img src="/Images/Companylogo/SEAInfonetLogo.png" alt="SEA Infonet" height="38" id="NavImage">
        </a>

        <ul class="sea-nav-links">
          <li><a href="/about">About</a></li>

          <li class="sea-has-dropdown">
            <a >Products ▾</a>
            <div class="sea-dropdown">
              <% (data || []).slice(0, 4).forEach(item=> { %>
                <a href="/product/<%= item.productKey %>">
                  <%= item.productKey .split("-") .map(w=> w.charAt(0).toUpperCase() + w.slice(1))
                    .join(" ") %>
                </a>
                <% }) %>
                  <a href="/product" style="color:#1b7f67;font-weight:700;">View All →</a>
            </div>
          </li>

          <li class="sea-has-dropdown">
            <a >Support ▾</a>
            <div class="sea-dropdown">
              <a href="/resource">🎫 Raise a Ticket</a>
              <a href="/resource">📚 Knowledge Base</a>
              <a href="/resource">🎓 Product Training</a>
            </div>
          </li>

          <li class="sea-has-dropdown">
            <a href="/contact">Partners ▾</a>
            <div class="sea-dropdown">
              <a href="/contact">🤝 Partner With Us</a>
              <a href="/resource">🔐 Partner Login</a>
            </div>
          </li>

          <li class="sea-has-dropdown">
            <a href="/resource">Resources ▾</a>
            <div class="sea-dropdown">
              <a href="/resource">📄 Datasheets</a>
              <a href="/resource">📊 Case Studies</a>
              <a href="/resource">🎓 Trainings</a>
              <a href="/resource">📅 Events &amp; Webinars</a>
            </div>
          </li>

          <li><a href="/msp">MSP</a></li>
          <li><a href="/contact">Contact</a></li>
        </ul>

        <a href="/demo" class="sea-nav-cta">Request a Demo</a>

        <button class="sea-hamburger" id="seaHamburger" aria-label="Menu">
          <span></span><span></span><span></span>
        </button>
      </div>
    </div>
  </nav>

  <%# ══ MOBILE MENU ══ %>
