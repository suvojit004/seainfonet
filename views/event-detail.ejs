<%# ════════════════════════════════════════════════════════════
    VIEW: views/event-detail.ejs
    CONTENT FRAGMENT ONLY — no <head>, <nav>, or <footer>.
    Drop this inside your existing layout's <body>, between your
    own header/nav and footer includes.

    Route example (controller):

      const Event = require('../models/event.model');

      router.get('/events/:slug', async (req, res) => {
        const event = await Event.findOne({ slug: req.params.slug }).lean();
        if (!event) return res.status(404).render('404');

        const relatedEvents = await Event.find({
          _id: { $ne: event._id },
          eventType: event.eventType,
          status: { $ne: 'draft' }
        }).limit(3).lean();

        res.render('event-detail', {
          pageTitle: (event.seoTitle || event.title) + ' — SEA Infonet',
          event,
          relatedEvents
        });
      });

    EXPECTED LOCALS
    ───────────────
    pageTitle      (optional string)  -> not used here since there's no <title>;
                                          set it in your own layout if needed
    event          (required object)  -> single Event document, shaped per event.model.js
    relatedEvents  (optional array)   -> other Event documents to show at the bottom

    CSS DEPENDENCY
    ──────────────
    This fragment uses classes like .ev-detail-hero, .ev-content-grid,
    .sp-card, .gallery-grid, .ev-info-card, .ev-cta-stack, .pill,
    .section-eyebrow/.section-title, .btn-primary/.btn-secondary/.btn-disabled,
    and #lightbox. Make sure those rules (from the previously-provided
    public/css/style.css) are available globally — either keep linking
    that file from your layout, or merge the component-specific rules
    into your own stylesheet.
═══════════════════════════════════════════════════════════ %>

<%- include('header', {data: header}) %>
<%- include('navbar', {data: navData}) %>
<%
  // ---- local helpers (scoped to this render only) -----------------------
  function escapeHtml(str) {
    if (str === undefined || str === null) return '';
    return String(str)
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#39;');
  }
  function formatDate(date, opts) {
    if (!date) return '';
    return new Date(date).toLocaleDateString('en-IN', opts || { day: 'numeric', month: 'long', year: 'numeric' });
  }
  function formatTime(date) {
    if (!date) return '';
    return new Date(date).toLocaleTimeString('en-IN', { hour: '2-digit', minute: '2-digit' });
  }
  function statusMeta(status) {
    var map = {
      upcoming:  { label: 'Upcoming',  cls: 'st-upcoming'  },
      completed: { label: 'Completed', cls: 'st-completed' },
      cancelled: { label: 'Cancelled', cls: 'st-cancelled'  }
    };
    return map[status] || { label: status, cls: 'st-draft' };
  }
  function typeIcon(type) {
    var map = { webinar: '🎥', workshop: '🛠️', training: '🎓', conference: '🏛️' };
    return map[type] || '📅';
  }
  function roleLabel(role) {
    var map = { speaker: 'Speaker', moderator: 'Moderator', host: 'Host', panelist: 'Panelist' };
    return map[role] || 'Speaker';
  }
  function initials(name) {
    if (!name) return '?';
    return name.trim().split(/\s+/).map(function (n) { return n[0]; }).slice(0, 2).join('').toUpperCase();
  }
  function daysUntil(date) {
    if (!date) return null;
    var diff = new Date(date).getTime() - Date.now();
    return Math.ceil(diff / (1000 * 60 * 60 * 24));
  }

  function renderSpeaker(sp) {
    var avatar = sp.profileImage
      ? '<img src="' + escapeHtml(sp.profileImage) + '" alt="' + escapeHtml(sp.name) + '">'
      : '<span>' + initials(sp.name) + '</span>';
    var subParts = [sp.designation, sp.company].filter(Boolean).map(escapeHtml).join(' · ');
    return '' +
    '<div class="sp-card">' +
      '<div class="sp-avatar">' + avatar + '</div>' +
      '<div class="sp-info">' +
        '<h4>' + escapeHtml(sp.name) + ' <span class="sp-role">' + roleLabel(sp.role) + '</span></h4>' +
        (subParts ? '<p class="sp-sub">' + subParts + '</p>' : '') +
        (sp.bio ? '<p class="sp-bio">' + escapeHtml(sp.bio) + '</p>' : '') +
        (sp.linkedinUrl ? '<a href="' + escapeHtml(sp.linkedinUrl) + '" target="_blank" rel="noopener" class="sp-linkedin">💼 LinkedIn Profile</a>' : '') +
      '</div>' +
    '</div>';
  }

  function renderEventCard(ev) {
    var st = statusMeta(ev.status);
    var media = ev.bannerImage
      ? '<img src="' + escapeHtml(ev.bannerImage) + '" alt="' + escapeHtml(ev.title) + '" loading="lazy">'
      : '<div class="ev-card-fallback">' + typeIcon(ev.eventType) + '</div>';
    var slug = encodeURIComponent(ev.slug || '');
    return '' +
    '<a href="/events/' + slug + '" class="ev-card reveal">' +
      '<div class="ev-card-media">' + media + '<span class="ev-badge-status pill ' + st.cls + '">' + st.label + '</span></div>' +
      '<div class="ev-card-body">' +
        '<span class="ev-card-type">' + typeIcon(ev.eventType) + ' ' + escapeHtml(ev.eventType) + '</span>' +
        '<h3>' + escapeHtml(ev.title) + '</h3>' +
        '<p>' + escapeHtml(ev.shortDescription || '') + '</p>' +
      '</div>' +
      '<div class="ev-card-cta">View Details →</div>' +
    '</a>';
  }

  // ---- derive page data ---------------------------------------------------
  var ev = (typeof event !== 'undefined' && event) ? event : {};
  var related = (typeof relatedEvents !== 'undefined' && Array.isArray(relatedEvents)) ? relatedEvents : [];
  var st = statusMeta(ev.status);
  var deadlineDays = daysUntil(ev.registrationDeadline);
  var registrationClosed = ev.registrationDeadline ? (deadlineDays !== null && deadlineDays < 0) : false;
  var pageUrl = (typeof currentUrl !== 'undefined') ? currentUrl : '';
%>

<a href="/events" class="ev-back">← Back to Events</a>

<!-- ══ HERO ══ -->
<section class="ev-detail-hero">
  <% if (ev.bannerImage) { %><img class="bg" src="<%= ev.bannerImage %>" alt=""><% } %>
  <div class="overlay"></div>
  <div class="container inner">
    <div class="pills">
      <span class="pill <%= st.cls %>"><%= st.label %></span>
      <span class="pill" style="background:rgba(255,189,89,.15);color:var(--gold)"><%= typeIcon(ev.eventType) %> <%= ev.eventType %></span>
      <% if (ev.isFeatured) { %><span class="pill" style="background:rgba(255,189,89,.2);color:var(--gold)">★ Featured</span><% } %>
      <% if (ev.certificateAvailable) { %><span class="pill" style="background:rgba(27,127,103,.18);color:#9fe8d4">🎓 Certificate Provided</span><% } %>
    </div>
    <h1><%= ev.title %></h1>
    <div class="ev-detail-meta-bar">
      <span>📅 <strong><%= formatDate(ev.eventDate) %></strong></span>
      <span>🕒 <strong><%= formatTime(ev.eventDate) %><%= ev.eventEndDate ? ' – ' + formatTime(ev.eventEndDate) : '' %></strong> (<%= ev.timezone %>)</span>
      <% if (ev.maxParticipants) { %><span>👥 Limited to <strong><%= ev.maxParticipants %></strong> participants</span><% } %>
    </div>
  </div>
</section>

<!-- ══ CONTENT ══ -->
<section id="detail-content">
  <div class="container">
    <div class="ev-content-grid">

      <!-- MAIN COLUMN -->
      <div class="ev-main">

        <% if (ev.shortDescription) { %>
          <div class="ev-block">
            <p class="ev-lead"><%= ev.shortDescription %></p>
          </div>
        <% } %>

        <% if (ev.description) { %>
          <div class="ev-block">
            <h2 class="sub-heading">About This Event</h2>
            <p class="ev-description"><%= ev.description %></p>
          </div>
        <% } %>

        <% if (ev.speakers && ev.speakers.length) { %>
          <div class="ev-block">
            <h2 class="sub-heading">Speakers &amp; Panelists</h2>
            <div class="sp-grid">
              <% ev.speakers.forEach(function (sp) { %>
                <%- renderSpeaker(sp) %>
              <% }) %>
            </div>
          </div>
        <% } %>

        <% if (ev.galleryImages && ev.galleryImages.length) { %>
          <div class="ev-block">
            <h2 class="sub-heading">Gallery</h2>
            <div class="gallery-grid">
              <% ev.galleryImages.forEach(function (img, i) { %>
                <div class="gallery-thumb" data-full="<%= img %>" onclick="openLightbox('<%= img %>')">
                  <img src="<%= img %>" alt="Gallery image <%= i + 1 %>" loading="lazy">
                </div>
              <% }) %>
            </div>
          </div>
        <% } %>

        <% if (ev.status === 'completed' && ev.recordingUrl) { %>
          <div class="ev-block">
            <div class="ev-recording">
              <div>
                <h3>📹 Session Recording Available</h3>
                <p>Catch up on everything covered during this session.</p>
              </div>
              <a href="<%= ev.recordingUrl %>" target="_blank" rel="noopener" class="btn-primary">Watch Recording →</a>
            </div>
          </div>
        <% } %>

      </div>

      <!-- SIDEBAR -->
      <div class="ev-sidebar">
        <div class="ev-info-card">
          <div class="ev-info-row">
            <span class="label">📅 Date</span>
            <span class="value"><%= formatDate(ev.eventDate) %></span>
          </div>
          <div class="ev-info-row">
            <span class="label">🕒 Time</span>
            <span class="value"><%= formatTime(ev.eventDate) %><%= ev.eventEndDate ? ' – ' + formatTime(ev.eventEndDate) : '' %></span>
          </div>
          <div class="ev-info-row">
            <span class="label">🌐 Timezone</span>
            <span class="value"><%= ev.timezone %></span>
          </div>
          <div class="ev-info-row">
            <span class="label"><%= typeIcon(ev.eventType) %> Format</span>
            <span class="value" style="text-transform:capitalize"><%= ev.eventType %></span>
          </div>
          <% if (ev.maxParticipants) { %>
          <div class="ev-info-row">
            <span class="label">👥 Capacity</span>
            <span class="value"><%= ev.maxParticipants %> seats</span>
          </div>
          <% } %>
          <% if (ev.registrationDeadline) { %>
          <div class="ev-info-row">
            <span class="label">⏳ Registration Closes</span>
            <span class="value"><%= formatDate(ev.registrationDeadline) %></span>
          </div>
          <% } %>
          <% if (ev.certificateAvailable) { %>
          <div class="ev-info-row">
            <span class="label">🎓 Certificate</span>
            <span class="value">Provided on completion</span>
          </div>
          <% } %>

          <div class="ev-cta-stack">
            <% if (ev.status === 'upcoming' && !registrationClosed && ev.registrationLink) { %>
              <a href="<%= ev.registrationLink %>" target="_blank" rel="noopener" class="btn-primary">Register Now →</a>
              <% if (deadlineDays !== null && deadlineDays >= 0) { %>
                <div class="ev-deadline-note"><%= deadlineDays === 0 ? 'Registration closes today' : deadlineDays + ' day' + (deadlineDays > 1 ? 's' : '') + ' left to register' %></div>
              <% } %>
            <% } else if (ev.status === 'upcoming' && registrationClosed) { %>
              <span class="btn-disabled">Registration Closed</span>
            <% } else if (ev.status === 'completed' && ev.recordingUrl) { %>
              <a href="<%= ev.recordingUrl %>" target="_blank" rel="noopener" class="btn-primary">Watch Recording →</a>
            <% } else if (ev.status === 'cancelled') { %>
              <span class="btn-disabled">Event Cancelled</span>
            <% } else { %>
              <span class="btn-disabled">Event Completed</span>
            <% } %>

            <% if (ev.status === 'upcoming' && ev.meetingLink) { %>
              <a href="<%= ev.meetingLink %>" target="_blank" rel="noopener" class="btn-secondary">🔗 Join Meeting Link</a>
            <% } %>
          </div>

          <div class="ev-share">
            <a class="ev-social-btn" href="https://wa.me/?text=<%= encodeURIComponent(ev.title + ' — ' + pageUrl) %>" target="_blank" rel="noopener" title="Share on WhatsApp">💬</a>
            <a class="ev-social-btn" href="https://www.linkedin.com/sharing/share-offsite/?url=<%= encodeURIComponent(pageUrl) %>" target="_blank" rel="noopener" title="Share on LinkedIn">💼</a>
            <a class="ev-social-btn" href="mailto:?subject=<%= encodeURIComponent(ev.title) %>&body=<%= encodeURIComponent(pageUrl) %>" title="Share via Email">✉️</a>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>

<!-- ══ RELATED EVENTS ══ -->
<% if (related.length) { %>
<section id="related">
  <div class="container">
    <div class="section-eyebrow">More Like This</div>
    <h2 class="section-title">Related Events</h2>
    <div class="ev-grid" style="margin-top:32px">
      <% related.forEach(function (r) { %>
        <%- renderEventCard(r) %>
      <% }) %>
    </div>
  </div>
</section>
<% } %>

<!-- LIGHTBOX -->
<div id="lightbox">
  <span id="lightbox-close" onclick="closeLightbox()">✕</span>
  <img id="lightbox-img" src="" alt="Gallery preview">
</div>

<script>
  function openLightbox(src) {
    var lb = document.getElementById('lightbox');
    document.getElementById('lightbox-img').src = src;
    lb.classList.add('open');
  }
  function closeLightbox() {
    document.getElementById('lightbox').classList.remove('open');
  }
  document.getElementById('lightbox').addEventListener('click', function (e) {
    if (e.target.id === 'lightbox') closeLightbox();
  });
  document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape') closeLightbox();
  });

  // Scroll-reveal for .reveal elements — include once per page is fine,
  // remove this block if your layout already runs an equivalent observer.
  (function () {
    var reveals = document.querySelectorAll('.reveal');
    if (!reveals.length) return;
    var observer = new IntersectionObserver(function (entries) {
      entries.forEach(function (e) { if (e.isIntersecting) e.target.classList.add('visible'); });
    }, { threshold: 0.1 });
    reveals.forEach(function (el) { observer.observe(el); });
  })();
</script>
<%- include('footer', {data: productCardData}) %>
