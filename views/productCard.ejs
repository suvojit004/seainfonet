<div class="productSlide-card">
  <div class="productSlide-imgwrap">
    <img src="<%= data.url %>" alt="<%= data.name %>">
  </div>
  <div class="productSlide-body">
    <h3 class="productSlide-name"><%= data.name %></h3>
    <p class="productSlide-desc"><%= data.description %></p>
    <button class="productSlide-btn"
      data-bs-toggle="modal"
      data-bs-target="#talkToExpert">
      <%= data.btntxt %>
    </button>
  </div>
</div>