    </div>
    <div class="plans-table-wrap">
      <table class="plans-table">
        <thead>
          <tr>
            <th>Tier</th>
            <th>Best Suited For</th>
            <th>Key Benefits</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td>Authorized Partner</td>
            <td>New resellers and system integrators just starting out</td>
            <td>Standard partner pricing, access to the training catalog, and technical support</td>
          </tr>
          <tr>
            <td>Silver Partner</td>
            <td>Resellers with a track record of repeat business</td>
            <td><span class="plans-plan-badge">Deal Registration</span> priority handling, improved margins, quarterly business reviews</td>
          </tr>
          <tr>
            <td>Gold Partner <span class="plans-plan-badge" style="margin-left:6px">★ Most Common</span></td>
            <td>Established partners running consistent volume across multiple brands</td>
            <td>Dedicated account manager, early access to new releases</td>
          </tr>
          <tr>
            <td>Platinum Partner</td>
            <td>Strategic partners with certified teams across our full portfolio</td>
            <td>Top-tier margins, executive sponsorship, input into our regional roadmap</td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>
</section>

<!-- ══ PARTNER ENQUIRY FORM ══ -->
<section class="partner-enquiry-wrap" id="partner-form">
  <div class="container">

    

    <div class="demo-card">
      <div class="demo-left">
        <div class="demo-orbit-wrap">
          <div class="demo-orbit-ring"><div class="demo-orbit-dot"></div></div>
          <div class="demo-orbit-ring"><div class="demo-orbit-dot"></div></div>
          <div class="demo-orbit-ring"><div class="demo-orbit-dot"></div></div>
        </div>
        <div class="demo-left-content">
          <span class="demo-eyebrow">Become a Partner</span>
          <h2 class="demo-headline">Let's build your <span>security practice</span> together</h2>
          <div class="demo-divider"></div>
          <p class="demo-sub">Tell us a little about your business and what you'd like to sell, and our channel team will set up a short onboarding call to get you started.</p>
          <div class="demo-book-tag">⚡ Most applications reviewed within 24 hours</div>
          <div class="demo-trust">
            <div class="demo-trust-item"><span class="demo-trust-dot" style="background:#1b7f67;box-shadow:0 0 6px #1b7f67"></span> No setup fees to become an Authorized Partner</div>
            <div class="demo-trust-item"><span class="demo-trust-dot" style="background:#ffbd59;box-shadow:0 0 6px #ffbd59"></span> Dedicated channel manager from day one</div>
            <div class="demo-trust-item"><span class="demo-trust-dot" style="background:#4ecba8;box-shadow:0 0 6px #4ecba8"></span> Free training on your first registered deal</div>
          </div>
        </div>
      </div>

      <div class="demo-right">
        <h3 class="demo-form-title">Partnership Inquiry</h3>
        <p class="demo-form-sub">Fields marked * are required.</p>
        <form class="demo-form-grid" method="POST" action="/api-partner-inquiry" id="partnerInquiryForm">
          <div style="display:none;">
                <input type="text" name="website" tabindex="-1" autocomplete="off" />
              </div>
              <input type="hidden" name="formLoadedAt" id="formLoadedAt" />
          <div class="demo-field">
            <label for="pw-fullName">Full Name *</label>
            <input id="pw-fullName" type="text" name="fullName" placeholder="Rajan Kumar" required>
          </div>
          <div class="demo-field">
            <label for="pw-companyName">Company Name *</label>
            <input id="pw-companyName" type="text" name="companyName" placeholder="Acme IT Solutions" required>
          </div>
          <div class="demo-field">
            <label for="pw-email">Business Email *</label>
            <input id="pw-email" type="email" name="email" placeholder="you@company.com" required>
          </div>
          <div class="demo-field">
            <label for="pw-phone">Phone Number *</label>
            <input id="pw-phone" type="tel" name="phone" placeholder="+91 98765 43210" required>
          </div>
          <div class="demo-field">
            <label for="pw-companyType">Company Type</label>
            <select id="pw-companyType" name="companyType">
              <option value="">Select one</option>
              <option value="reseller">Reseller</option>
              <option value="system-integrator">System Integrator</option>
              <option value="msp">Managed Service Provider</option>
              <option value="distributor">Distributor</option>
              <option value="other">Other</option>
            </select>
          </div>
          <div class="demo-field">
            <label for="pw-interest">Primary Interest</label>
            <select id="pw-interest" name="interest">
              <option value="">Select a product area</option>
              <option value="kaspersky">Kaspersky</option>
              <option value="bytescreen">ByteScreen</option>
              <option value="safetica">Safetica DLP &amp; IRM</option>
              <option value="acronis">Acronis </option>
              <option value="teramind">Teramind</option>
              <option value="godmarc">GoDMARC</option>
              <option value="multiple">Multiple / Not Sure Yet</option>
            </select>
          </div>
          <div class="demo-field full">
            <label for="pw-message">Tell Us About Your Business</label>
            <textarea id="pw-message" name="message" placeholder="Current customer base, target industries, regions you cover, etc."></textarea>
          </div>
          <button type="submit" class="demo-submit">Submit Partnership Inquiry →</button>
        </form>
      </div>
    </div>

  </div>
</section>

<!-- ══ CLOSING CTA ══ -->
<section class="rb-cta">
  <div class="rb-cta-inner">
    <span class="rb-cta-label">Ready When You Are</span>
    <h2 class="rb-cta-title">Join 2000+ Partners Already Growing With Us</h2>
    <div class="rb-cta-divider"></div>
    <p class="rb-cta-desc">Whether you're just getting started or looking to deepen an existing practice, our channel team is ready to help you find the right fit.</p>
    <a href="#partner-form" class="rb-cta-btn">Apply to Partner →</a>
  </div>
   <script>
      document.getElementById("formLoadedAt").value = Date.now();
    </script>
</section>

