<!-- ══ RESELLER BENEFITS ══ -->
<section class="rb-section">
  <div class="rb-inner">

    <div class="rb-head">
      <div class="rb-eyebrow">Partnership</div>
      <h2 class="rb-title">Reseller Benefits</h2>
      <div class="rb-divider"></div>
    </div>

    <div class="rb-grid">

      <!-- Left column -->
      <div class="rb-col">
        <div class="rb-col-head">
          <p class="rb-col-head-title">Commercial Benefits</p>
        </div>
        <ul class="rb-list">
          <% data[0].left.forEach(element => { %>
          <li class="rb-list-item"><%= element %></li>
          <% }); %>
        </ul>
      </div>

      <!-- Right column -->
      <div class="rb-col">
        <div class="rb-col-head">
          <p class="rb-col-head-title">Technical & Sales Support</p>
        </div>
        <ul class="rb-list">
          <% data[0].right.forEach(element => { %>
          <li class="rb-list-item"><%= element %></li>
          <% }); %>
        </ul>
      </div>

    </div>
  </div>
</section>

<!-- ══ CTA BAND ══ -->
<section class="rb-cta">
  <div class="rb-cta-inner">
    <div class="rb-cta-label">Get Started</div>
    <h2 class="rb-cta-title"><%= data[1].title %></h2>
    <div class="rb-cta-divider"></div>
    <p class="rb-cta-desc"><%= data[1].description %></p>
    <a href="/contact" class="rb-cta-btn">
      Partner With Us
      <svg width="14" height="14" viewBox="0 0 16 16" fill="none">
        <path d="M3 8h10M9 4l4 4-4 4" stroke="#0b1f1a" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </a>
  </div>
</section>