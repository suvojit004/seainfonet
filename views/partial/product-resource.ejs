<section class="res-section">
  <div class="res-inner">

    <div class="res-head">
      <div class="res-eyebrow">Learn More</div>
      <h2 class="res-title">Resources</h2>
      <div class="res-divider"></div>
    </div>

    <div class="res-grid">
      <% data.forEach((element, i) => { %>
      <div class="res-card">
        <div class="res-card-num"><%= String(i + 1).padStart(2, '0') %></div>
        <div class="res-card-title-wrap">
          <h3 class="res-card-title"><%= element.title %></h3>
          <div class="res-card-sep"></div>
        </div>
        <a href="<%= element.link %>" class="res-card-btn">
          <%= element.buttonText %>
          <svg width="13" height="13" viewBox="0 0 16 16" fill="none">
            <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
      </div>
      <% }); %>
    </div>

  </div>
</section>