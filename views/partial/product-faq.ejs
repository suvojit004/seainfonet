<section class="faq-section">
  <div class="faq-inner">

    <div class="faq-head">
      <div class="faq-eyebrow">Got Questions</div>
      <h2 class="faq-title">Frequently Asked Questions</h2>
      <div class="faq-divider"></div>
    </div>

    <div class="faq-list" id="faqList">
      <% data.forEach((element, index) => { %>
      <div class="faq-item">
        <button class="faq-btn" type="button">
          <%= element.question %>
          <div class="faq-chevron">
            <svg width="12" height="12" viewBox="0 0 16 16" fill="none">
              <path d="M3 6l5 5 5-5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </div>
        </button>
        <div class="faq-body">
          <div class="faq-answer"><%= element.answer %></div>
        </div>
      </div>
      <% }); %>
    </div>

  </div>
</section>