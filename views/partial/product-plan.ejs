<section class="plans-section">
  <div class="plans-inner">

    <div class="plans-head">
      <div class="plans-eyebrow">Pricing</div>
      <h2 class="plans-title">Plans</h2>
      <div class="plans-divider"></div>
    </div>

    <div class="plans-table-wrap">
      <table class="plans-table">
        <thead>
          <tr>
            <th>Plan</th>
            <th>Best For</th>
            <th>Key Features</th>
          </tr>
        </thead>
        <tbody>
          <% data.forEach(element => { %>
          <tr>
            <td><span class="plans-plan-badge"><%= element.plan %></span></td>
            <td><%= element.bestFor %></td>
            <td><%= element.keyFeatures %></td>
          </tr>
          <% }); %>
        </tbody>
      </table>
    </div>

  </div>
</section>