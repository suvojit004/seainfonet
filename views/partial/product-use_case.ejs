<section class="usecases">
  <div class="usecases-inner">

    <div class="usecases-head">
      <div class="usecases-eyebrow">Applications</div>
      <h2 class="usecases-title">Use Cases</h2>
      <div class="usecases-divider"></div>
    </div>

    <div class="usecases-grid">
      <% data.forEach((element, i) => { %>
      <div class="uc-card">
        <div class="uc-card-num"><%= String(i + 1).padStart(2, '0') %></div>
        <div class="uc-card-title-wrap">
          <h3 class="uc-card-title"><%= element.title %></h3>
          <div class="uc-card-sep"></div>
        </div>
        <p class="uc-card-desc"><%= element.description %></p>
      </div>
      <% }); %>
    </div>

  </div>
</section>