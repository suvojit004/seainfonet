<!-- Product Bootstrap Modal -->
<div class="modal fade" id="product-contentModal" tabindex="-1" aria-labelledby="product-contentModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-lg modal-dialog-centered">
    <div class="modal-content border-0 shadow-sm">

      <div class="modal-header">
        <h5 class="modal-title" id="product-contentModalLabel">Manage Product</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>

      <div class="modal-body">
        <form id="product-content-form">
          <!-- Dynamic product fields will be injected here -->
        </form>
      </div>

      <div class="modal-footer">
        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
          Cancel
        </button>
        <button type="button" class="btn btn-primary" id="product-save-content">
          Save
        </button>
      </div>

    </div>
  </div>
</div>