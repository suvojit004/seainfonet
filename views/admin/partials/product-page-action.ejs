              <div class="d-flex flex-wrap gap-2">
                <% data.forEach(element => { %>
                  <button class="btn" data-prdkey="<%= element.productKey %>" >
                  <%= element.productKey %>
                </button>
                <% }) %>
              </div>
            </div>
          </div>
