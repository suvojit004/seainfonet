<%- include("../header") %>

  <div class="container">

    <div class="row justify-content-center">

      <div class="col-md-4">

        <div class="card mt-5 shadow">

          <div class="card-body">

            <h3 class="mb-4 text-center">
              Admin Login
            </h3>





            <form action="/admin/login" method="POST">

              <div class="mb-3">

                <input
                  type="email"
                  name="email"
                  class="form-control"
                  placeholder="Email"
                  required
                >

              </div>





              <div class="mb-3">

                <input
                  type="password"
                  name="password"
                  class="form-control"
                  placeholder="Password"
                  required
                >

              </div>





              <button
                class="btn btn-primary w-100"
              >
                Login
              </button>

            </form>

          </div>

        </div>

      </div>

    </div>

  </div>

<%- include("../footer") %>