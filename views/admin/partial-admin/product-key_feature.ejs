<section class=" bg-light mb-4">
    <div class="container card">
        <h2>key Features</h2>
       <form id="keyFeaturesForm" data-productkey="<%= productKey %>" class="row align-items-center g-4">

  <!-- Left Content -->
  <div class="col-md-6">
    <div class="mb-3">
      <label class="form-label fw-semibold">Title</label>
      <input
        type="text"
        class="form-control"
        name="title"
        value="<%= keyFeatures.title || '' %>">
    </div>

    <div class="mb-4">
      <label class="form-label fw-semibold">Subtitle</label>
      <textarea
        class="form-control"
        name="subtitle"
        rows="3"><%= keyFeatures.subtitle || '' %></textarea>
    </div>

    <!-- Features -->
    <div class="mb-4">
      <div class="d-flex justify-content-between align-items-center mb-2">
        <label class="form-label fw-semibold mb-0">Features</label>
        <button type="button" class="btn btn-sm btn-outline-primary" onclick="addFeatureItem()">Add Feature</button>
      </div>

      <div id="featuresWrapper">
        <% (keyFeatures.features || []).forEach((item, index) => { %>
          <div class="border rounded-3 p-3 mb-3 feature-item">
            <div class="mb-2">
              <label class="form-label">Feature Title</label>
              <input
                type="text"
                class="form-control"
                name="features[<%= index %>][title]"
                value="<%= item.title || '' %>">
            </div>

            <div class="mb-2">
              <label class="form-label">Feature Description</label>
              <textarea
                class="form-control"
                name="features[<%= index %>][description]"
                rows="3"><%= item.description || '' %></textarea>
            </div>

            <button type="button" class="btn btn-sm btn-outline-danger" onclick="removeFeatureItem(this)">Remove</button>
          </div>
        <% }) %>
      </div>
    </div>
  </div>

  <!-- Right Image -->
  <div class="col-md-6 text-center">
    <div class="border rounded-4 p-3 bg-light">
      <img src="<%= keyFeatures.image %>" class="img-fluid rounded-3 mb-3" alt="product">

      <input type="hidden" name="image" value="<%= keyFeatures.image %>">

      <div class="text-start">
        <label class="form-label fw-semibold">Change Image</label>
        <input
          type="text"
          class="form-control"
          name="imagePreview"
          placeholder="Enter new image path">
        <small class="text-muted">Current image path is preserved unless changed.</small>
      </div>
    </div>
  </div>

  <!-- Actions -->
  <div class="col-12 text-end">
    <button type="submit" class="btn btn-primary px-4">Save Key Features</button>
  </div>
</form>
    </div>
</section>