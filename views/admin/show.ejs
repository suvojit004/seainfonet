<%- include("../header") %>

  <body class="bg-light">

    <div class="container-fluid">
      <div class="row min-vh-100">

        <!-- Sidebar -->
        <aside class="col-lg-3 col-xl-2 bg-white border-end p-0">
          <div class="p-4 border-bottom">
            <h4 class="mb-1">Content Manager</h4>
            <small class="text-muted">Admin Panel</small>
          </div>

          <div class="list-group list-group-flush rounded-0">
            <button class="list-group-item list-group-item-action active Home" data-section="Home">
              Home
            </button>
            <button class="list-group-item list-group-item-action Home" data-section="Products">
              Products
            </button>
            <button class="list-group-item list-group-item-action Home" data-section="Forms">
              Forms
            </button>
          </div>
        </aside>

        <!-- Content Panel -->
        <main class="col-lg-9 col-xl-10 p-4">
          <!-- Page Action Row -->
          <%- include("./partials/page-actions") %>
            <div id="content-area">
            </div>
            <%- include("./partials/carousel") %>
            <%- include("./partials/product") %>
            <%- include("./partials/use-case") %>
        </main>
      </div>
    </div>




    <script src="/Javascript/utils/admin.js" defer></script>
    <%- include("../footer") %>